{
  "name": "chmlib-ts",
  "version": "0.3.0",
  "description": "TypeScript port of chmlib - CHM archive reader",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./reader": {
      "import": "./dist/reader.js",
      "types": "./dist/reader.d.ts"
    },
    "./system": {
      "import": "./dist/system.js",
      "types": "./dist/system.d.ts"
    },
    "./toc": {
      "import": "./dist/toc.js",
      "types": "./dist/toc.d.ts"
    },
    "./types": {
      "import": "./dist/types.js",
      "types": "./dist/types.d.ts"
    }
  },
  "bin": "dist/cli.js",
  "files": [
    "dist",
    "README.md",
    "COPYING"
  ],
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "prepack": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  },
  "license": "LGPL-2.1"
}
