{
  "name": "@chm-md/core",
  "version": "0.3.0",
  "description": "Convert CHM bundles to MarkdownProject IR",
  "type": "module",
  "license": "LGPL-2.1-only",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/josh-hemphill/chm-markdown-transpiler.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/josh-hemphill/chm-markdown-transpiler#readme",
  "bugs": {
    "url": "https://github.com/josh-hemphill/chm-markdown-transpiler/issues"
  },
  "keywords": [
    "chm",
    "markdown",
    "vitepress",
    "documentation",
    "help"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "dependencies": {
    "@joplin/turndown-plugin-gfm": "^1.0.62",
    "gray-matter": "^4.0.3",
    "linkedom": "^0.18.12",
    "markdownlint": "^0.38.0",
    "turndown": "^7.2.0",
    "yaml": "^2.8.0",
    "@chm-md/extract": "0.3.0",
    "@chm-md/shared": "0.3.0"
  },
  "devDependencies": {
    "@types/turndown": "^5.0.5"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}